# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Every value here is loaded with a PROJET_ prefix (see projet/config.py);
# anything left unset falls back to the default shown.

# -- Core ----------------------------------------------------------------
# PROJET_DATABASE_URL=sqlite+pysqlite:///./projet.db
# PROJET_APP_BASE_URL=http://localhost:3000
# PROJET_API_BASE_URL=http://localhost:8000
# PROJET_ENVIRONMENT=development

# -- Storage ---------------------------------------------------------------
# Where uploaded files (CVs, submission snapshots, data pack files, logos)
# land, and the key signed URLs are HMAC'd with. Change the signing key
# before this ever serves real applicant data.
# PROJET_STORAGE_ROOT=./.storage
# PROJET_STORAGE_SIGNING_KEY=dev-insecure-change-me

# -- Google Workspace --------------------------------------------------------
# Absent credentials select the fake driver — the same one every test runs
# against — which records what it was asked to do but never calls Google.
# That means offer emails, kickoff invites and deadline snapshots go nowhere
# until one of the two credential vars below is set. Setup: a service account
# with domain-wide delegation impersonating a real mailbox in your Workspace,
# granted these scopes in the Workspace admin console (Security > API
# controls > Domain-wide delegation), not the Cloud Console:
#   https://www.googleapis.com/auth/gmail.send
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/drive.readonly
#   https://www.googleapis.com/auth/drive
#
# Set exactly one of the next two — a file path is simplest locally; the
# inline JSON is for hosts where you can only set environment variables.
# PROJET_GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
# PROJET_GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
#
# The mailbox the service account sends and creates events as. Must already
# exist as a real user in your Workspace domain.
# PROJET_GOOGLE_DELEGATED_SUBJECT=programs@yourdomain.com
#
# Force a driver regardless of whether credentials are set. Leave unset
# (auto) in normal use.
# PROJET_GOOGLE_DRIVER=auto  # auto | real | fake

# -- Anthropic drafting (problem statements, testimonials) --------------------
# Absent, those endpoints report themselves unavailable rather than
# failing obscurely — nothing else depends on this.
# PROJET_ANTHROPIC_API_KEY=

# -- Admin access code ---------------------------------------------------
# A shared secret that signs in as platform admin with no password. Unset
# (the default) disables the endpoint entirely; it never falls back to a
# built-in code. Treat a set value exactly like a shared password: anyone
# holding it has full admin access, no per-person identity, no audit trail —
# strictly weaker than the per-account password auth every other actor uses.
# Never commit this.
# PROJET_ADMIN_ACCESS_CODE=
# PROJET_ADMIN_BOOTSTRAP_EMAIL=admin@projet.sg
# PROJET_ADMIN_BOOTSTRAP_NAME=Admin

# -- Outbox ----------------------------------------------------------------
# PROJET_OUTBOX_MAX_ATTEMPTS=5
# PROJET_OUTBOX_BACKOFF_BASE_SECONDS=30
